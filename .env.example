# Produção (recomendado)
DEBUG=0
HEADLESS=1
PORT=8080
HOST=0.0.0.0

# Fallback de navegador (quando alguma loja trava/timeout na primeira tentativa)
# ENABLE_BROWSER_FALLBACK=1
# Se a primeira tentativa for LOCAL (USE_REMOTE=0), permite tentar via Selenoid como fallback.
# SELENOID_FALLBACK_ENABLED=1

# Selenoid (opcional, recomendado no servidor para isolar o browser)
# USE_REMOTE=1
# SELENOID_URL=http://selenoid:4444/wd/hub

# Proxy (opcional) para servir dois sistemas no mesmo dominio:
# / => MAIN_UPSTREAM (ex: agente de precos)
# /frete => FREIGHT_UPSTREAM (este projeto)
# Dica: use FREIGHT_PREFIX sem barra no final ("/frete" e nao "/frete/").
# Se voce usar Tailscale Serve com --set-path /frete, defina PUBLIC_URL_PREFIX=/frete para corrigir CSS/links.
# PROXY_HOST=0.0.0.0
# PROXY_PORT=8600
# MAIN_UPSTREAM=http://host.docker.internal:8501
# FREIGHT_PREFIX=/frete
# FREIGHT_UPSTREAM=http://127.0.0.1:8080
#
# PUBLIC_URL_PREFIX=/frete

# Persistência de resultados/artefatos
ARTIFACTS_DIR=artifacts
RESULTS_CSV_PATH=artifacts/results.csv
# Remove automaticamente screenshots e HTML com mais de 2 dias
ARTIFACT_RETENTION_DAYS=2

# Segurança (recomendado em servidor)
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASS=troque-esta-senha
#
# Restrição de URLs (evita uso indevido/SSRF). Exemplos:
# ALLOWED_URL_HOSTS=probel.com.br,www.probel.com.br
# ALLOWED_URL_HOSTS=.probel.com.br
# ALLOWED_URL_HOSTS=*.probel.com.br

# Performance (ajuste conforme CPU/RAM do servidor)
WEB_CONCURRENCY=1
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=300
MAX_CONCURRENT_JOBS=2
SHEET_PARALLEL_LIMIT=3

# Selenoid (quando USE_REMOTE=1). Aumente se alguns sites forem lentos e a sessÃ£o cair.
SELENOID_SESSION_TIMEOUT=15m
